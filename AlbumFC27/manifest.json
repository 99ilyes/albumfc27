{
  "manifest_version": 3,
  "name": "AlbumFC27",
  "version": "1.2.0",
  "description": "Complète un ensemble de la Galerie FC 27 : joueurs du set (fut.gg ou marché), achat puis remise en vente immédiate juste sous le marché.",
  "action": { "default_popup": "popup.html", "default_title": "AlbumFC27" },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.ea.com/ea-sports-fc/ultimate-team/web-app/*",
    "https://www.ea.com/*/ea-sports-fc/ultimate-team/web-app/*",
    "https://www.fut.gg/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.ea.com/ea-sports-fc/ultimate-team/web-app/*",
        "https://www.ea.com/*/ea-sports-fc/ultimate-team/web-app/*"
      ],
      "js": ["main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.ea.com/ea-sports-fc/ultimate-team/web-app/*",
        "https://www.ea.com/*/ea-sports-fc/ultimate-team/web-app/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.fut.gg/*"],
      "js": ["futgg.js"],
      "run_at": "document_idle"
    }
  ]
}
