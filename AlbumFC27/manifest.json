{
  "manifest_version": 3,
  "name": "AlbumFC27",
  "version": "0.2.0",
  "description": "Complète la Galerie FC 27 : achète les joueurs des ensembles et les remet en vente au prix d'achat.",
  "action": { "default_popup": "popup.html", "default_title": "AlbumFC27" },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.ea.com/ea-sports-fc/ultimate-team/web-app/*",
    "https://www.ea.com/*/ea-sports-fc/ultimate-team/web-app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.ea.com/ea-sports-fc/ultimate-team/web-app/*",
        "https://www.ea.com/*/ea-sports-fc/ultimate-team/web-app/*"
      ],
      "js": ["main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.ea.com/ea-sports-fc/ultimate-team/web-app/*",
        "https://www.ea.com/*/ea-sports-fc/ultimate-team/web-app/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
