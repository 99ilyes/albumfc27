{
  "manifest_version": 3,
  "name": "FC27 Trader",
  "version": "1.4.3",
  "description": "Web App FC 27 : sniper qui tourne sans interruption pour gagner des crédits, et remplissage automatique des sets de la Galerie (catalogue fut.gg).",
  "action": {
    "default_popup": "popup.html",
    "default_title": "FC27 Trader",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png"
    }
  },
  "permissions": [
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://www.ea.com/ea-sports-fc/ultimate-team/web-app/*",
    "https://www.ea.com/*/ea-sports-fc/ultimate-team/web-app/*",
    "https://www.fut.gg/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.ea.com/ea-sports-fc/ultimate-team/web-app/*",
        "https://www.ea.com/*/ea-sports-fc/ultimate-team/web-app/*"
      ],
      "js": [
        "core.js",
        "stats.js",
        "sniper.js",
        "album.js",
        "ui.js",
        "boot.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.ea.com/ea-sports-fc/ultimate-team/web-app/*",
        "https://www.ea.com/*/ea-sports-fc/ultimate-team/web-app/*"
      ],
      "js": [
        "futgg-parse.js",
        "bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.fut.gg/*"
      ],
      "js": [
        "futgg-parse.js",
        "futgg.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
